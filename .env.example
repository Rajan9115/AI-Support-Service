# ResolveAI Environment Variables Example
# Copy to .env and replace placeholder values for local development.
# Never commit real secrets or .env files.

# Runtime environment: development | test | staging | production
NODE_ENV=development

# API server port
PORT=4000

# MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/resolveai

# Redis connection string for BullMQ and rate limiting
REDIS_URL=redis://localhost:6379

# Dashboard session signing secret (minimum 32 characters)
SESSION_SECRET=replace-with-a-32-char-minimum-random-secret

# Comma-separated list of allowed dashboard origins for CORS
ALLOWED_DASHBOARD_ORIGINS=http://localhost:3000

# Gemini API key (required in Phase 6+)
GEMINI_API_KEY=

# Gemini generation and embedding models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Structured logger level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Public API base URL for Next.js dashboard
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
